# Copy this file to .env.local in apps/web.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Set by the Convex CLI:
CONVEX_DEPLOYMENT=dev:your-deployment

# Server-only. Set the SAME value in the Convex deployment environment.
HOST_JWT_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
